# TurfVision AI — Environment Settings

# System Environment
APP_NAME=TurfVision AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Gateway Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=turfvision_dev_secret_key_change_in_production

# Database Configuration (PostgreSQL)
POSTGRES_USER=turfvision
POSTGRES_PASSWORD=turfvision_pass
POSTGRES_DB=turfvision_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://turfvision:turfvision_pass@localhost:5432/turfvision_db

# Redis Configuration (PubSub & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Vision Engine Settings
YOLO_MODEL_PATH=models/yolov8x.pt
BALL_YOLO_MODEL_PATH=models/football_yolo.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
DEVICE=cuda:0 # or cpu

# Video Processing Target
DEFAULT_TARGET_FPS=30
FRAME_QUEUE_MAX_SIZE=100
